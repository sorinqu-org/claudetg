TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Real provider credentials exist only in the controller container.
CUSTOM_PROVIDER_API_KEY=

# Generate with: openssl rand -hex 32
# Used only for controller <-> worker control callbacks. It is never passed to Claude Code.
CLAUDETG_INTERNAL_TOKEN=

# Host directory mounted only into worker-main as /workspace.
CLAUDETG_PROJECT_PATH=/srv/projects/main

CONFIG_PATH=/app/config/config.json
DATA_DIR=/app/data
HEALTH_PORT=3000
ALLOW_GROUP_CHATS=false
LOG_LEVEL=info

TOKEN_EFFICIENCY_ENABLED=true
SEMBLE_ENABLED=true
SERENA_ENABLED=false
CONTEXT7_ENABLED=false
MCP_TIMEOUT=60000

CLAUDE_CODE_EFFORT_LEVEL=medium
CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false
CLAUDE_CODE_DISABLE_THINKING=false
