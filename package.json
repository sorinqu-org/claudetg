{
  "name": "claudetg",
  "version": "2.0.0",
  "private": true,
  "description": "Telegram controller and isolated Claude Agent SDK workers",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --enable-source-maps dist/index.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "dev": "npm run build && node --watch --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@ast-grep/cli": "0.44.1",
    "ctx7": "0.5.6",
    "grammy": "1.45.1",
    "repomix": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
